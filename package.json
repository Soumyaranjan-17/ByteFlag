{
  "name": "byteflags",
  "version": "1.1.0",
  "description": "A tiny utility library that packs up to 8 boolean settings inside 1 byte using bit manipulation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soumyaranjan-17/ByteFlag.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "keywords": [
    "bitmask",
    "flags",
    "boolean",
    "optimization",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}